@Entry
@Component
struct PrivacyTextPage {
  @State pageTitle: string = '使用条款及隐私政策';
  @State docTitle: string = '山东管理学院移动校园隐私政策';
  @State metaText: string = PRIVACY_META;
  @State sections: PolicySection[] = PRIVACY_SECTIONS;
  @StorageProp('currentBreakpoint') currentBreakpoint: string = 'sm';
  @StorageProp('avoidAreaBottomVp') avoidAreaBottomVp: number = 0;

  aboutToAppear(): void {
    const params: object = router.getParams();
    if (params !== null && params !== undefined) {
      const record = params as Record<string, Object>;
      const typeValue: Object = record['type'];
      if (typeof typeValue === 'string') {
        if (typeValue === 'service') {
          this.pageTitle = '服务协议';
          this.docTitle = '山东管理学院移动校园用户服务协议';
          this.metaText = SERVICE_META;
          this.sections = SERVICE_SECTIONS;
        } else if (typeValue === 'privacy') {
          this.pageTitle = '隐私政策';
          this.docTitle = '山东管理学院移动校园隐私政策';
          this.metaText = PRIVACY_META;
          this.sections = PRIVACY_SECTIONS;
        }
      }
    }
  }

  build() {
    Column() {
      TitleBar({ title: this.pageTitle, showBack: true })

      Scroll() {
        Column({ space: 14 }) {
          Text(this.docTitle)
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor($r('app.color.common_color_1'))
            .width('100%')

          Text(this.metaText)
            .fontSize(12)
            .fontColor($r('app.color.common_color_3'))
            .width('100%')
            .padding({ bottom: 8 })
            .border({ width: { bottom: 0.5 }, color: { bottom: '#E5E7EB' } })

          ForEach(this.sections, (section: PolicySection, idx: number) => {
            Column({ space: 6 }) {
              Text(section.title)
                .fontSize(16)
                .fontWeight(FontWeight.Bold)
                .fontColor($r('app.color.common_color_1'))
                .width('100%')
              Text(section.body)
                .fontSize(14.5)
                .fontColor($r('app.color.common_color_2'))
                .lineHeight(24)
                .width('100%')
            }
            .width('100%')
            .padding({ top: idx === 0 ? 4 : 8 })
          }, (section: PolicySection, idx: number) => `${this.pageTitle}_${idx}_${section.title}`)
        }
        .width('100%')
        .constraintSize({ maxWidth: BreakpointSystem.getContentMaxWidth(this.currentBreakpoint) })
        .padding({ left: 18, right: 18, top: 18, bottom: Math.max(36, this.avoidAreaBottomVp + 24) })
        .alignItems(HorizontalAlign.Start)
      }
      .width('100%')
      .layoutWeight(1)
      .scrollBar(BarState.Off)
      .align(Alignment.Top)
      .backgroundColor($r('app.color.white'))
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.white'))
  }
}
